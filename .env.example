# Local Docker Compose defaults. Never commit real credentials in this file.
DEBUG=True
SECRET_KEY=replace-with-a-long-random-value
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=bookshop
DB_USER=bookshop
DB_PASSWORD=replace-with-a-database-password
DB_HOST=db
DB_PORT=5432
DATABASE_URL=

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-redis-password
REDIS_URL=

STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

WAREHOUSE_INTEGRATION_ENABLED=True
WAREHOUSE_BASE_URL=http://api:5000/api/v1
WAREHOUSE_SERVICE_API_KEY=replace-with-one-shared-service-key
WAREHOUSE_CONNECT_TIMEOUT=2
WAREHOUSE_READ_TIMEOUT=5
WAREHOUSE_HTTP_RETRIES=2
WAREHOUSE_HTTP_RETRY_BACKOFF=0.25

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_RELEASE=

CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=False
